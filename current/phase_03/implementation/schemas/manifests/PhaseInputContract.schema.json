{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csthv/IHARQ/schemas/manifests/PhaseInputContract.schema.json",
  "title": "PhaseInputContract",
  "type": "object",
  "required": [
    "contract_id",
    "phase_id",
    "required_inputs",
    "limitations_required"
  ],
  "properties": {
    "contract_id": {
      "type": "string"
    },
    "phase_id": {
      "type": "string"
    },
    "required_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "limitations_required": {
      "const": true
    }
  },
  "additionalProperties": false,
  "x-iharq-status": "PHASE0_FOUNDATION_PROFILE"
}

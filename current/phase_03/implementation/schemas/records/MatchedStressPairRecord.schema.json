{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csthv/IHARQ/schemas/records/MatchedStressPairRecord.schema.json",
  "title": "MatchedStressPairRecord Phase 0 foundation profile",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "schema_version",
    "authority_status",
    "owner_layer",
    "phase_id",
    "config_id",
    "source_ids",
    "evidence_mode",
    "limitation_tags",
    "lifecycle_status",
    "fixture",
    "fixture_tags",
    "evidence_role",
    "payload"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^IHARQ-[A-Z][A-Z0-9_]*-[0-9]{8}-[0-9a-f]{16}$"
    },
    "schema_version": {
      "const": "1.0-foundation"
    },
    "phase_id": {
      "const": "P00"
    },
    "config_id": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_mode": {
      "enum": [
        "FOUNDATION",
        "IMPLEMENTATION",
        "CONFORMANCE",
        "VALIDATION",
        "REPRODUCIBILITY_READINESS"
      ]
    },
    "limitation_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lifecycle_status": {
      "enum": [
        "CREATED",
        "VALIDATED",
        "ACCEPTED",
        "DIAGNOSTIC_ONLY",
        "BLOCKED",
        "SUPERSEDED",
        "INVALIDATED"
      ]
    },
    "fixture": {
      "type": "boolean"
    },
    "fixture_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_role": {
      "enum": [
        "PRIMARY",
        "DERIVED",
        "GOVERNANCE",
        "RENDERING",
        "PACKAGING"
      ]
    },
    "ablation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "record_type": {
      "const": "MatchedStressPairRecord"
    },
    "authority_status": {
      "const": "SOURCE_REFERENCED_LOCAL_PROFILE"
    },
    "owner_layer": {
      "const": "L8"
    },
    "payload": {
      "type": "object",
      "required": [
        "matched_stress_pair_id",
        "clean_id",
        "stressed_id",
        "matching_keys"
      ],
      "properties": {
        "matched_stress_pair_id": {
          "type": "string"
        },
        "clean_id": {
          "type": "string"
        },
        "stressed_id": {
          "type": "string"
        },
        "matching_keys": {
          "type": "array"
        },
        "stress_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "stress_application_id": {
          "type": "string",
          "minLength": 1
        },
        "match_status": {
          "enum": [
            "MATCHED",
            "UNMATCHED",
            "INVALID"
          ]
        },
        "validity_status": {
          "enum": [
            "VALID",
            "DIAGNOSTIC_ONLY",
            "INVALID"
          ]
        },
        "diagnostic_status": {
          "enum": [
            "NONE",
            "DIAGNOSTIC_ONLY",
            "BLOCKED"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "x-iharq-authority-status": "SOURCE_REFERENCED_LOCAL_PROFILE"
}

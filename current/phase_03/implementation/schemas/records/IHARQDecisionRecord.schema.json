{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csthv/IHARQ/schemas/records/IHARQDecisionRecord.schema.json",
  "title": "IHARQDecisionRecord Phase 0 foundation profile",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "schema_version",
    "authority_status",
    "owner_layer",
    "phase_id",
    "config_id",
    "source_ids",
    "evidence_mode",
    "limitation_tags",
    "lifecycle_status",
    "fixture",
    "fixture_tags",
    "evidence_role",
    "payload"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^IHARQ-[A-Z][A-Z0-9_]*-[0-9]{8}-[0-9a-f]{16}$"
    },
    "record_type": {
      "const": "IHARQDecisionRecord"
    },
    "schema_version": {
      "const": "1.0-foundation"
    },
    "authority_status": {
      "const": "REGISTRY_REFERENCED"
    },
    "owner_layer": {
      "const": "L4"
    },
    "phase_id": {
      "const": "P00"
    },
    "config_id": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_mode": {
      "enum": [
        "FOUNDATION",
        "IMPLEMENTATION",
        "CONFORMANCE",
        "VALIDATION",
        "REPRODUCIBILITY_READINESS"
      ]
    },
    "limitation_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lifecycle_status": {
      "enum": [
        "CREATED",
        "VALIDATED",
        "ACCEPTED",
        "DIAGNOSTIC_ONLY",
        "BLOCKED",
        "SUPERSEDED",
        "INVALIDATED"
      ]
    },
    "fixture": {
      "type": "boolean"
    },
    "fixture_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_role": {
      "enum": [
        "PRIMARY",
        "DERIVED",
        "GOVERNANCE",
        "RENDERING",
        "PACKAGING"
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "iharq_decision_id",
            "evidence_quality_ids",
            "action",
            "reason_code",
            "fallback"
          ],
          "properties": {
            "iharq_decision_id": {
              "type": "string"
            },
            "evidence_quality_ids": {
              "type": "array"
            },
            "action": {
              "type": "string"
            },
            "reason_code": {
              "type": "string"
            },
            "fallback": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "iharq_decision_id",
            "request_id",
            "evidence_quality_ids",
            "source_prediction_id",
            "source_uncertainty_id",
            "decision_status",
            "action",
            "reason_codes",
            "fallback_action",
            "method_id",
            "rule_id",
            "trace_id",
            "explanation_id",
            "abstained"
          ],
          "properties": {
            "iharq_decision_id": {
              "type": "string",
              "minLength": 1
            },
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "evidence_quality_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "source_prediction_id": {
              "type": "string",
              "minLength": 1
            },
            "source_uncertainty_id": {
              "type": "string",
              "minLength": 1
            },
            "decision_status": {
              "enum": [
                "ACCEPTED",
                "ABSTAINED",
                "DEFERRED",
                "FALLBACK",
                "BLOCKED",
                "INVALID",
                "DIAGNOSTIC_ONLY"
              ]
            },
            "action": {
              "enum": [
                "ACCEPT",
                "ABSTAIN",
                "DEFER",
                "ESCALATE",
                "SAFE_FALLBACK",
                "BLOCK"
              ]
            },
            "reason_codes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "fallback_action": {
              "enum": [
                "NONE",
                "ABSTAIN",
                "DEFER",
                "ESCALATE",
                "SAFE_STOP"
              ]
            },
            "method_id": {
              "type": "string",
              "minLength": 1
            },
            "rule_id": {
              "type": "string",
              "minLength": 1
            },
            "trace_id": {
              "type": "string",
              "minLength": 1
            },
            "explanation_id": {
              "type": "string",
              "minLength": 1
            },
            "abstained": {
              "type": "boolean"
            },
            "limitation_summary": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ablation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "x-iharq-authority-status": "REGISTRY_REFERENCED"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csthv/IHARQ/schemas/records/StateRecord.schema.json",
  "title": "StateRecord Phase 0 foundation profile",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "schema_version",
    "authority_status",
    "owner_layer",
    "phase_id",
    "config_id",
    "source_ids",
    "evidence_mode",
    "limitation_tags",
    "lifecycle_status",
    "fixture",
    "fixture_tags",
    "evidence_role",
    "payload"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^IHARQ-[A-Z][A-Z0-9_]*-[0-9]{8}-[0-9a-f]{16}$"
    },
    "record_type": {
      "const": "StateRecord"
    },
    "schema_version": {
      "const": "1.0-foundation"
    },
    "authority_status": {
      "const": "REGISTRY_REFERENCED"
    },
    "owner_layer": {
      "const": "L7"
    },
    "phase_id": {
      "const": "P00"
    },
    "config_id": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_mode": {
      "enum": [
        "FOUNDATION",
        "IMPLEMENTATION",
        "CONFORMANCE",
        "VALIDATION",
        "REPRODUCIBILITY_READINESS"
      ]
    },
    "limitation_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lifecycle_status": {
      "enum": [
        "CREATED",
        "VALIDATED",
        "ACCEPTED",
        "DIAGNOSTIC_ONLY",
        "BLOCKED",
        "SUPERSEDED",
        "INVALIDATED"
      ]
    },
    "fixture": {
      "type": "boolean"
    },
    "fixture_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_role": {
      "enum": [
        "PRIMARY",
        "DERIVED",
        "GOVERNANCE",
        "RENDERING",
        "PACKAGING"
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "state_id",
            "episode_id",
            "state_payload"
          ],
          "properties": {
            "state_id": {
              "type": "string"
            },
            "episode_id": {
              "type": "string"
            },
            "state_payload": {
              "type": "object"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "state_id",
            "episode_id",
            "session_id",
            "time_index",
            "environment_id",
            "state_payload",
            "terminal_status",
            "simulation_config_id"
          ],
          "properties": {
            "state_id": {
              "type": "string",
              "minLength": 1
            },
            "episode_id": {
              "type": "string",
              "minLength": 1
            },
            "session_id": {
              "type": "string",
              "minLength": 1
            },
            "time_index": {
              "type": "integer",
              "minimum": 0
            },
            "environment_id": {
              "type": "string",
              "minLength": 1
            },
            "state_payload": {
              "type": "object"
            },
            "terminal_status": {
              "enum": [
                "ACTIVE",
                "TERMINAL",
                "INVALID",
                "BLOCKED"
              ]
            },
            "simulation_config_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ablation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "x-iharq-authority-status": "REGISTRY_REFERENCED"
}

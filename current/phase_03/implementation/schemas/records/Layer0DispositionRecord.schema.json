{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csthv/IHARQ/schemas/records/Layer0DispositionRecord.schema.json",
  "title": "Layer0DispositionRecord Phase 0 foundation profile",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "schema_version",
    "authority_status",
    "owner_layer",
    "phase_id",
    "config_id",
    "source_ids",
    "evidence_mode",
    "limitation_tags",
    "lifecycle_status",
    "fixture",
    "fixture_tags",
    "evidence_role",
    "payload"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^IHARQ-[A-Z][A-Z0-9_]*-[0-9]{8}-[0-9a-f]{16}$"
    },
    "record_type": {
      "const": "Layer0DispositionRecord"
    },
    "schema_version": {
      "const": "1.0-foundation"
    },
    "authority_status": {
      "const": "SOURCE_REFERENCED_LOCAL_PROFILE"
    },
    "owner_layer": {
      "const": "L0"
    },
    "phase_id": {
      "const": "P00"
    },
    "config_id": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_mode": {
      "enum": [
        "FOUNDATION",
        "IMPLEMENTATION",
        "CONFORMANCE",
        "VALIDATION",
        "REPRODUCIBILITY_READINESS"
      ]
    },
    "limitation_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lifecycle_status": {
      "enum": [
        "CREATED",
        "VALIDATED",
        "ACCEPTED",
        "DIAGNOSTIC_ONLY",
        "BLOCKED",
        "SUPERSEDED",
        "INVALIDATED"
      ]
    },
    "fixture": {
      "type": "boolean"
    },
    "fixture_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_role": {
      "enum": [
        "PRIMARY",
        "DERIVED",
        "GOVERNANCE",
        "RENDERING",
        "PACKAGING"
      ]
    },
    "payload": {
      "type": "object",
      "required": [
        "layer0_disposition_id",
        "statement_id",
        "status",
        "limitations",
        "review_roles"
      ],
      "properties": {
        "layer0_disposition_id": {
          "type": "string"
        },
        "statement_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "limitations": {
          "type": "string"
        },
        "review_roles": {
          "type": "array"
        },
        "claim_version": {
          "type": "string"
        },
        "evidence_maturity": {
          "type": "string"
        },
        "sufficiency": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "claim_ceiling": {
          "type": "string"
        },
        "permitted_wording": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prohibited_wording": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mandatory_qualifications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_mode": {
          "const": "LLM_ONLY"
        },
        "review_provenance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "layer10_handoff_fields": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "ablation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "x-iharq-authority-status": "SOURCE_REFERENCED_LOCAL_PROFILE"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csthv/IHARQ/schemas/records/StressScheduleRecord.schema.json",
  "title": "StressScheduleRecord Phase 0 foundation profile",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "schema_version",
    "authority_status",
    "owner_layer",
    "phase_id",
    "config_id",
    "source_ids",
    "evidence_mode",
    "limitation_tags",
    "lifecycle_status",
    "fixture",
    "fixture_tags",
    "evidence_role",
    "payload"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^IHARQ-[A-Z][A-Z0-9_]*-[0-9]{8}-[0-9a-f]{16}$"
    },
    "schema_version": {
      "const": "1.0-foundation"
    },
    "phase_id": {
      "const": "P00"
    },
    "config_id": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_mode": {
      "enum": [
        "FOUNDATION",
        "IMPLEMENTATION",
        "CONFORMANCE",
        "VALIDATION",
        "REPRODUCIBILITY_READINESS"
      ]
    },
    "limitation_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lifecycle_status": {
      "enum": [
        "CREATED",
        "VALIDATED",
        "ACCEPTED",
        "DIAGNOSTIC_ONLY",
        "BLOCKED",
        "SUPERSEDED",
        "INVALIDATED"
      ]
    },
    "fixture": {
      "type": "boolean"
    },
    "fixture_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_role": {
      "enum": [
        "PRIMARY",
        "DERIVED",
        "GOVERNANCE",
        "RENDERING",
        "PACKAGING"
      ]
    },
    "ablation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "record_type": {
      "const": "StressScheduleRecord"
    },
    "authority_status": {
      "const": "REGISTRY_REFERENCED"
    },
    "owner_layer": {
      "const": "L8"
    },
    "payload": {
      "type": "object",
      "required": [
        "stress_schedule_id",
        "stress_profile_id",
        "schedule_type",
        "schedule",
        "duration",
        "seed",
        "matched_clean_run_id",
        "schedule_status"
      ],
      "properties": {
        "stress_schedule_id": {
          "type": "string",
          "minLength": 1
        },
        "stress_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "schedule_type": {
          "type": "string",
          "minLength": 1
        },
        "schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "step",
              "intensity"
            ],
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 0
              },
              "intensity": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "duration": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "matched_clean_run_id": {
          "type": "string",
          "minLength": 1
        },
        "schedule_status": {
          "enum": [
            "VALIDATED",
            "DIAGNOSTIC_ONLY",
            "INVALID"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-iharq-authority-status": "REGISTRY_REFERENCED"
}

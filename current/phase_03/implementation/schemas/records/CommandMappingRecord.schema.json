{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csthv/IHARQ/schemas/records/CommandMappingRecord.schema.json",
  "title": "CommandMappingRecord Phase 0 foundation profile",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "schema_version",
    "authority_status",
    "owner_layer",
    "phase_id",
    "config_id",
    "source_ids",
    "evidence_mode",
    "limitation_tags",
    "lifecycle_status",
    "fixture",
    "fixture_tags",
    "evidence_role",
    "payload"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^IHARQ-[A-Z][A-Z0-9_]*-[0-9]{8}-[0-9a-f]{16}$"
    },
    "schema_version": {
      "const": "1.0-foundation"
    },
    "phase_id": {
      "const": "P00"
    },
    "config_id": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_mode": {
      "enum": [
        "FOUNDATION",
        "IMPLEMENTATION",
        "CONFORMANCE",
        "VALIDATION",
        "REPRODUCIBILITY_READINESS"
      ]
    },
    "limitation_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lifecycle_status": {
      "enum": [
        "CREATED",
        "VALIDATED",
        "ACCEPTED",
        "DIAGNOSTIC_ONLY",
        "BLOCKED",
        "SUPERSEDED",
        "INVALIDATED"
      ]
    },
    "fixture": {
      "type": "boolean"
    },
    "fixture_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_role": {
      "enum": [
        "PRIMARY",
        "DERIVED",
        "GOVERNANCE",
        "RENDERING",
        "PACKAGING"
      ]
    },
    "ablation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "record_type": {
      "const": "CommandMappingRecord"
    },
    "authority_status": {
      "const": "SOURCE_REFERENCED_LOCAL_PROFILE"
    },
    "owner_layer": {
      "const": "L9"
    },
    "payload": {
      "type": "object",
      "required": [
        "command_mapping_id",
        "source_action_tokens",
        "simulator_commands",
        "mapping_version",
        "safety_constraints",
        "mapping_status"
      ],
      "properties": {
        "command_mapping_id": {
          "type": "string",
          "minLength": 1
        },
        "source_action_tokens": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "simulator_commands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "mapping_version": {
          "type": "string",
          "minLength": 1
        },
        "safety_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "mapping_status": {
          "enum": [
            "VALIDATED",
            "BLOCKED",
            "INVALID"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-iharq-authority-status": "SOURCE_REFERENCED_LOCAL_PROFILE"
}

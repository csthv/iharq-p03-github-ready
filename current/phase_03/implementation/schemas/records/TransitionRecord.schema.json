{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csthv/IHARQ/schemas/records/TransitionRecord.schema.json",
  "title": "TransitionRecord Phase 0 foundation profile",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "schema_version",
    "authority_status",
    "owner_layer",
    "phase_id",
    "config_id",
    "source_ids",
    "evidence_mode",
    "limitation_tags",
    "lifecycle_status",
    "fixture",
    "fixture_tags",
    "evidence_role",
    "payload"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^IHARQ-[A-Z][A-Z0-9_]*-[0-9]{8}-[0-9a-f]{16}$"
    },
    "record_type": {
      "const": "TransitionRecord"
    },
    "schema_version": {
      "const": "1.0-foundation"
    },
    "authority_status": {
      "const": "REGISTRY_REFERENCED"
    },
    "owner_layer": {
      "const": "L7"
    },
    "phase_id": {
      "const": "P00"
    },
    "config_id": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_mode": {
      "enum": [
        "FOUNDATION",
        "IMPLEMENTATION",
        "CONFORMANCE",
        "VALIDATION",
        "REPRODUCIBILITY_READINESS"
      ]
    },
    "limitation_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lifecycle_status": {
      "enum": [
        "CREATED",
        "VALIDATED",
        "ACCEPTED",
        "DIAGNOSTIC_ONLY",
        "BLOCKED",
        "SUPERSEDED",
        "INVALIDATED"
      ]
    },
    "fixture": {
      "type": "boolean"
    },
    "fixture_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_role": {
      "enum": [
        "PRIMARY",
        "DERIVED",
        "GOVERNANCE",
        "RENDERING",
        "PACKAGING"
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "transition_id",
            "state_id",
            "action_id",
            "next_state_id",
            "reward",
            "cost"
          ],
          "properties": {
            "transition_id": {
              "type": "string"
            },
            "state_id": {
              "type": "string"
            },
            "action_id": {
              "type": "string"
            },
            "next_state_id": {
              "type": "string"
            },
            "reward": {
              "type": [
                "number",
                "string"
              ]
            },
            "cost": {
              "type": [
                "number",
                "string"
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "transition_id",
            "state_id",
            "action_id",
            "next_state_id",
            "episode_id",
            "session_id",
            "time_index",
            "reward",
            "cost",
            "reward_version",
            "cost_version",
            "terminal_status",
            "safety_event_ids"
          ],
          "properties": {
            "transition_id": {
              "type": "string",
              "minLength": 1
            },
            "state_id": {
              "type": "string",
              "minLength": 1
            },
            "action_id": {
              "type": "string",
              "minLength": 1
            },
            "next_state_id": {
              "type": "string",
              "minLength": 1
            },
            "episode_id": {
              "type": "string",
              "minLength": 1
            },
            "session_id": {
              "type": "string",
              "minLength": 1
            },
            "time_index": {
              "type": "integer",
              "minimum": 0
            },
            "reward": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "cost": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "reward_version": {
              "type": "string",
              "minLength": 1
            },
            "cost_version": {
              "type": "string",
              "minLength": 1
            },
            "terminal_status": {
              "enum": [
                "CONTINUE",
                "TERMINAL",
                "INVALID",
                "BLOCKED"
              ]
            },
            "safety_event_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "simulation_status": {
              "const": "SIMULATION_ONLY"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ablation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "x-iharq-authority-status": "REGISTRY_REFERENCED"
}

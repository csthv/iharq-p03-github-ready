{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csthv/IHARQ/schemas/records/DashboardMetricRecord.schema.json",
  "title": "DashboardMetricRecord Phase 0 foundation profile",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "schema_version",
    "authority_status",
    "owner_layer",
    "phase_id",
    "config_id",
    "source_ids",
    "evidence_mode",
    "limitation_tags",
    "lifecycle_status",
    "fixture",
    "fixture_tags",
    "evidence_role",
    "payload"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^IHARQ-[A-Z][A-Z0-9_]*-[0-9]{8}-[0-9a-f]{16}$"
    },
    "schema_version": {
      "const": "1.0-foundation"
    },
    "phase_id": {
      "const": "P00"
    },
    "config_id": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_mode": {
      "enum": [
        "FOUNDATION",
        "IMPLEMENTATION",
        "CONFORMANCE",
        "VALIDATION",
        "REPRODUCIBILITY_READINESS"
      ]
    },
    "limitation_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lifecycle_status": {
      "enum": [
        "CREATED",
        "VALIDATED",
        "ACCEPTED",
        "DIAGNOSTIC_ONLY",
        "BLOCKED",
        "SUPERSEDED",
        "INVALIDATED"
      ]
    },
    "fixture": {
      "type": "boolean"
    },
    "fixture_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_role": {
      "enum": [
        "PRIMARY",
        "DERIVED",
        "GOVERNANCE",
        "RENDERING",
        "PACKAGING"
      ]
    },
    "ablation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "record_type": {
      "const": "DashboardMetricRecord"
    },
    "authority_status": {
      "const": "REGISTRY_REFERENCED"
    },
    "owner_layer": {
      "const": "L10"
    },
    "payload": {
      "type": "object",
      "required": [
        "dashboard_metric_id",
        "metric_entry_id",
        "source_artifact_ids",
        "rendering_only"
      ],
      "properties": {
        "dashboard_metric_id": {
          "type": "string"
        },
        "metric_entry_id": {
          "type": "string"
        },
        "source_artifact_ids": {
          "type": "array"
        },
        "rendering_only": {
          "const": true
        },
        "source_bundle_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "denominator": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "recomputed": {
          "const": false
        },
        "metric_status": {
          "enum": [
            "VALIDATED",
            "NEGATIVE",
            "DIAGNOSTIC_ONLY",
            "FAILED",
            "UNRESOLVED"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "x-iharq-authority-status": "REGISTRY_REFERENCED"
}

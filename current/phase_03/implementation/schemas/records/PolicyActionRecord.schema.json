{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csthv/IHARQ/schemas/records/PolicyActionRecord.schema.json",
  "title": "PolicyActionRecord Phase 0 foundation profile",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "schema_version",
    "authority_status",
    "owner_layer",
    "phase_id",
    "config_id",
    "source_ids",
    "evidence_mode",
    "limitation_tags",
    "lifecycle_status",
    "fixture",
    "fixture_tags",
    "evidence_role",
    "payload"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^IHARQ-[A-Z][A-Z0-9_]*-[0-9]{8}-[0-9a-f]{16}$"
    },
    "record_type": {
      "const": "PolicyActionRecord"
    },
    "schema_version": {
      "const": "1.0-foundation"
    },
    "authority_status": {
      "const": "REGISTRY_REFERENCED"
    },
    "owner_layer": {
      "const": "L6"
    },
    "phase_id": {
      "const": "P00"
    },
    "config_id": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_mode": {
      "enum": [
        "FOUNDATION",
        "IMPLEMENTATION",
        "CONFORMANCE",
        "VALIDATION",
        "REPRODUCIBILITY_READINESS"
      ]
    },
    "limitation_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lifecycle_status": {
      "enum": [
        "CREATED",
        "VALIDATED",
        "ACCEPTED",
        "DIAGNOSTIC_ONLY",
        "BLOCKED",
        "SUPERSEDED",
        "INVALIDATED"
      ]
    },
    "fixture": {
      "type": "boolean"
    },
    "fixture_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_role": {
      "enum": [
        "PRIMARY",
        "DERIVED",
        "GOVERNANCE",
        "RENDERING",
        "PACKAGING"
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "policy_action_id",
            "context_id",
            "action",
            "policy_id"
          ],
          "properties": {
            "policy_action_id": {
              "type": "string"
            },
            "context_id": {
              "type": "string"
            },
            "action": {
              "type": "string"
            },
            "policy_id": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "policy_action_id",
            "context_id",
            "action",
            "policy_id",
            "policy_mode",
            "cost",
            "expected_reward",
            "budget_after",
            "constraint_status",
            "update_eligible"
          ],
          "properties": {
            "policy_action_id": {
              "type": "string",
              "minLength": 1
            },
            "context_id": {
              "type": "string",
              "minLength": 1
            },
            "action": {
              "enum": [
                "ACCEPT",
                "DEFER",
                "ESCALATE",
                "SAFE_STOP",
                "ABSTAIN"
              ]
            },
            "policy_id": {
              "type": "string",
              "minLength": 1
            },
            "policy_mode": {
              "enum": [
                "ADAPTIVE_TRAINING",
                "FROZEN_EVALUATION",
                "RULE_BASED",
                "DIAGNOSTIC_ONLY"
              ]
            },
            "cost": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "expected_reward": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "budget_after": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "constraint_status": {
              "enum": [
                "LEGAL",
                "ILLEGAL",
                "BLOCKED"
              ]
            },
            "update_eligible": {
              "type": "boolean"
            },
            "simulation_status": {
              "const": "SIMULATION_ONLY"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ablation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "x-iharq-authority-status": "REGISTRY_REFERENCED"
}

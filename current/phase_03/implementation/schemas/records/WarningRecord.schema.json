{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csthv/IHARQ/schemas/records/WarningRecord.schema.json",
  "title": "WarningRecord Phase 0 foundation profile",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "schema_version",
    "authority_status",
    "owner_layer",
    "phase_id",
    "config_id",
    "source_ids",
    "evidence_mode",
    "limitation_tags",
    "lifecycle_status",
    "fixture",
    "fixture_tags",
    "evidence_role",
    "payload"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^IHARQ-[A-Z][A-Z0-9_]*-[0-9]{8}-[0-9a-f]{16}$"
    },
    "record_type": {
      "const": "WarningRecord"
    },
    "schema_version": {
      "const": "1.0-foundation"
    },
    "authority_status": {
      "const": "SOURCE_REFERENCED_LOCAL_PROFILE"
    },
    "owner_layer": {
      "const": "L5"
    },
    "phase_id": {
      "const": "P00"
    },
    "config_id": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_mode": {
      "enum": [
        "FOUNDATION",
        "IMPLEMENTATION",
        "CONFORMANCE",
        "VALIDATION",
        "REPRODUCIBILITY_READINESS"
      ]
    },
    "limitation_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lifecycle_status": {
      "enum": [
        "CREATED",
        "VALIDATED",
        "ACCEPTED",
        "DIAGNOSTIC_ONLY",
        "BLOCKED",
        "SUPERSEDED",
        "INVALIDATED"
      ]
    },
    "fixture": {
      "type": "boolean"
    },
    "fixture_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_role": {
      "enum": [
        "PRIMARY",
        "DERIVED",
        "GOVERNANCE",
        "RENDERING",
        "PACKAGING"
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "warning_id",
            "state_id",
            "reason_code",
            "severity"
          ],
          "properties": {
            "warning_id": {
              "type": "string"
            },
            "state_id": {
              "type": "string"
            },
            "reason_code": {
              "type": "string"
            },
            "severity": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "warning_id",
            "state_id",
            "warning_type",
            "reason_code",
            "severity",
            "issued_at",
            "action",
            "recovery_provenance_ids"
          ],
          "properties": {
            "warning_id": {
              "type": "string",
              "minLength": 1
            },
            "state_id": {
              "type": "string",
              "minLength": 1
            },
            "warning_type": {
              "enum": [
                "WARNING",
                "STOP_LOSS",
                "COOLDOWN",
                "RECOVERY",
                "SILENT_RESET_BLOCK"
              ]
            },
            "reason_code": {
              "type": "string",
              "minLength": 1
            },
            "severity": {
              "enum": [
                "INFO",
                "CAUTION",
                "HIGH",
                "CRITICAL"
              ]
            },
            "issued_at": {
              "type": "string",
              "format": "date-time"
            },
            "action": {
              "enum": [
                "OBSERVE",
                "DEFER",
                "COOLDOWN",
                "SAFE_STOP",
                "RECOVER",
                "BLOCK"
              ]
            },
            "recovery_provenance_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "cooldown_until": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "recovery_status": {
              "enum": [
                "NOT_APPLICABLE",
                "PENDING",
                "VALIDATED",
                "FAILED"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ablation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "x-iharq-authority-status": "SOURCE_REFERENCED_LOCAL_PROFILE"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csthv/IHARQ/schemas/records/StressProfileRecord.schema.json",
  "title": "StressProfileRecord Phase 0 foundation profile",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "schema_version",
    "authority_status",
    "owner_layer",
    "phase_id",
    "config_id",
    "source_ids",
    "evidence_mode",
    "limitation_tags",
    "lifecycle_status",
    "fixture",
    "fixture_tags",
    "evidence_role",
    "payload"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^IHARQ-[A-Z][A-Z0-9_]*-[0-9]{8}-[0-9a-f]{16}$"
    },
    "schema_version": {
      "const": "1.0-foundation"
    },
    "phase_id": {
      "const": "P00"
    },
    "config_id": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_mode": {
      "enum": [
        "FOUNDATION",
        "IMPLEMENTATION",
        "CONFORMANCE",
        "VALIDATION",
        "REPRODUCIBILITY_READINESS"
      ]
    },
    "limitation_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lifecycle_status": {
      "enum": [
        "CREATED",
        "VALIDATED",
        "ACCEPTED",
        "DIAGNOSTIC_ONLY",
        "BLOCKED",
        "SUPERSEDED",
        "INVALIDATED"
      ]
    },
    "fixture": {
      "type": "boolean"
    },
    "fixture_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_role": {
      "enum": [
        "PRIMARY",
        "DERIVED",
        "GOVERNANCE",
        "RENDERING",
        "PACKAGING"
      ]
    },
    "ablation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "record_type": {
      "const": "StressProfileRecord"
    },
    "authority_status": {
      "const": "REGISTRY_REFERENCED"
    },
    "owner_layer": {
      "const": "L8"
    },
    "payload": {
      "type": "object",
      "required": [
        "stress_profile_id",
        "stress_type",
        "intensity",
        "seed"
      ],
      "properties": {
        "stress_profile_id": {
          "type": "string"
        },
        "stress_type": {
          "type": "string"
        },
        "intensity": {
          "type": [
            "number",
            "string"
          ]
        },
        "seed": {
          "type": "integer"
        },
        "taxonomy_id": {
          "type": "string",
          "minLength": 1
        },
        "duration": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
        },
        "injection_point": {
          "type": "string",
          "minLength": 1
        },
        "target_type": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "clean_source_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_status": {
          "enum": [
            "DRAFT",
            "VALIDATED",
            "BLOCKED",
            "INVALID"
          ]
        },
        "validity_status": {
          "enum": [
            "VALID",
            "DIAGNOSTIC_ONLY",
            "INVALID"
          ]
        },
        "failure_code": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "x-iharq-authority-status": "REGISTRY_REFERENCED"
}

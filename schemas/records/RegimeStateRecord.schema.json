{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csthv/IHARQ/schemas/records/RegimeStateRecord.schema.json",
  "title": "RegimeStateRecord Phase 0 foundation profile",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "schema_version",
    "authority_status",
    "owner_layer",
    "phase_id",
    "config_id",
    "source_ids",
    "evidence_mode",
    "limitation_tags",
    "lifecycle_status",
    "fixture",
    "fixture_tags",
    "evidence_role",
    "payload"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^IHARQ-[A-Z][A-Z0-9_]*-[0-9]{8}-[0-9a-f]{16}$"
    },
    "record_type": {
      "const": "RegimeStateRecord"
    },
    "schema_version": {
      "const": "1.0-foundation"
    },
    "authority_status": {
      "const": "REGISTRY_REFERENCED"
    },
    "owner_layer": {
      "const": "L5"
    },
    "phase_id": {
      "const": "P00"
    },
    "config_id": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_mode": {
      "enum": [
        "FOUNDATION",
        "IMPLEMENTATION",
        "CONFORMANCE",
        "VALIDATION",
        "REPRODUCIBILITY_READINESS"
      ]
    },
    "limitation_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lifecycle_status": {
      "enum": [
        "CREATED",
        "VALIDATED",
        "ACCEPTED",
        "DIAGNOSTIC_ONLY",
        "BLOCKED",
        "SUPERSEDED",
        "INVALIDATED"
      ]
    },
    "fixture": {
      "type": "boolean"
    },
    "fixture_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_role": {
      "enum": [
        "PRIMARY",
        "DERIVED",
        "GOVERNANCE",
        "RENDERING",
        "PACKAGING"
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "regime_state_id",
            "time_index",
            "regime",
            "trust_state"
          ],
          "properties": {
            "regime_state_id": {
              "type": "string"
            },
            "time_index": {
              "type": "integer"
            },
            "regime": {
              "type": "string"
            },
            "trust_state": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "regime_state_id",
            "sequence_id",
            "window_id",
            "time_index",
            "timestamp",
            "regime",
            "trust_state",
            "previous_state_id",
            "transition_evidence_ids"
          ],
          "properties": {
            "regime_state_id": {
              "type": "string",
              "minLength": 1
            },
            "sequence_id": {
              "type": "string",
              "minLength": 1
            },
            "window_id": {
              "type": "string",
              "minLength": 1
            },
            "time_index": {
              "type": "integer",
              "minimum": 0
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "regime": {
              "enum": [
                "STABLE",
                "DEGRADED",
                "VOLATILE",
                "RECOVERY",
                "UNKNOWN"
              ]
            },
            "trust_state": {
              "enum": [
                "TRUSTED",
                "CAUTION",
                "UNTRUSTED",
                "RECOVERING",
                "BLOCKED"
              ]
            },
            "previous_state_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "transition_evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "persistence_count": {
              "type": "integer",
              "minimum": 0
            },
            "hysteresis_state": {
              "enum": [
                "ENTERING",
                "PERSISTING",
                "EXITING",
                "NOT_APPLICABLE"
              ]
            },
            "silent_reset": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ablation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "x-iharq-authority-status": "REGISTRY_REFERENCED"
}

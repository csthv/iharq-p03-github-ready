{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csthv/IHARQ/schemas/records/EvidenceQualityRecord.schema.json",
  "title": "EvidenceQualityRecord Phase 0 foundation profile",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "schema_version",
    "authority_status",
    "owner_layer",
    "phase_id",
    "config_id",
    "source_ids",
    "evidence_mode",
    "limitation_tags",
    "lifecycle_status",
    "fixture",
    "fixture_tags",
    "evidence_role",
    "payload"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^IHARQ-[A-Z][A-Z0-9_]*-[0-9]{8}-[0-9a-f]{16}$"
    },
    "record_type": {
      "const": "EvidenceQualityRecord"
    },
    "schema_version": {
      "const": "1.0-foundation"
    },
    "authority_status": {
      "const": "REGISTRY_REFERENCED"
    },
    "owner_layer": {
      "const": "L4"
    },
    "phase_id": {
      "const": "P00"
    },
    "config_id": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_mode": {
      "enum": [
        "FOUNDATION",
        "IMPLEMENTATION",
        "CONFORMANCE",
        "VALIDATION",
        "REPRODUCIBILITY_READINESS"
      ]
    },
    "limitation_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lifecycle_status": {
      "enum": [
        "CREATED",
        "VALIDATED",
        "ACCEPTED",
        "DIAGNOSTIC_ONLY",
        "BLOCKED",
        "SUPERSEDED",
        "INVALIDATED"
      ]
    },
    "fixture": {
      "type": "boolean"
    },
    "fixture_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_role": {
      "enum": [
        "PRIMARY",
        "DERIVED",
        "GOVERNANCE",
        "RENDERING",
        "PACKAGING"
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "evidence_quality_id",
            "request_id",
            "producer_id",
            "variant_id",
            "quality_status"
          ],
          "properties": {
            "evidence_quality_id": {
              "type": "string"
            },
            "request_id": {
              "type": "string"
            },
            "producer_id": {
              "type": "string"
            },
            "variant_id": {
              "type": "string"
            },
            "quality_status": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "evidence_quality_id",
            "request_id",
            "producer_id",
            "variant_id",
            "source_evidence_ids",
            "quality_status",
            "compatibility_status",
            "freshness_status",
            "corroboration_status",
            "insufficiency_reasons"
          ],
          "properties": {
            "evidence_quality_id": {
              "type": "string",
              "minLength": 1
            },
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "producer_id": {
              "type": "string",
              "minLength": 1
            },
            "variant_id": {
              "type": "string",
              "minLength": 1
            },
            "source_evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "quality_status": {
              "enum": [
                "SUFFICIENT",
                "PARTIAL",
                "INSUFFICIENT",
                "INCOMPATIBLE",
                "INVALID",
                "DIAGNOSTIC_ONLY"
              ]
            },
            "compatibility_status": {
              "enum": [
                "COMPATIBLE",
                "INCOMPATIBLE",
                "UNKNOWN"
              ]
            },
            "freshness_status": {
              "enum": [
                "CURRENT",
                "STALE",
                "UNKNOWN"
              ]
            },
            "corroboration_status": {
              "enum": [
                "CORROBORATED",
                "SINGLE_SOURCE",
                "CONFLICTING",
                "NOT_APPLICABLE"
              ]
            },
            "insufficiency_reasons": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "quality_score": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "producer_owner": {
              "type": "string",
              "minLength": 1
            },
            "variant_lineage_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ablation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "x-iharq-authority-status": "REGISTRY_REFERENCED"
}

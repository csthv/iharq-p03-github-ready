{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csthv/IHARQ/schemas/records/ThresholdRegistryRecord.schema.json",
  "title": "ThresholdRegistryRecord Phase 0 foundation profile",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "schema_version",
    "authority_status",
    "owner_layer",
    "phase_id",
    "config_id",
    "source_ids",
    "evidence_mode",
    "limitation_tags",
    "lifecycle_status",
    "fixture",
    "fixture_tags",
    "evidence_role",
    "payload"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^IHARQ-[A-Z][A-Z0-9_]*-[0-9]{8}-[0-9a-f]{16}$"
    },
    "record_type": {
      "const": "ThresholdRegistryRecord"
    },
    "schema_version": {
      "const": "1.0-foundation"
    },
    "authority_status": {
      "const": "REGISTRY_REFERENCED"
    },
    "owner_layer": {
      "const": "L3"
    },
    "phase_id": {
      "const": "P00"
    },
    "config_id": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_mode": {
      "enum": [
        "FOUNDATION",
        "IMPLEMENTATION",
        "CONFORMANCE",
        "VALIDATION",
        "REPRODUCIBILITY_READINESS"
      ]
    },
    "limitation_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lifecycle_status": {
      "enum": [
        "CREATED",
        "VALIDATED",
        "ACCEPTED",
        "DIAGNOSTIC_ONLY",
        "BLOCKED",
        "SUPERSEDED",
        "INVALIDATED"
      ]
    },
    "fixture": {
      "type": "boolean"
    },
    "fixture_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_role": {
      "enum": [
        "PRIMARY",
        "DERIVED",
        "GOVERNANCE",
        "RENDERING",
        "PACKAGING"
      ]
    },
    "payload": {
      "type": "object",
      "required": [
        "threshold_id",
        "metric_entry_id",
        "value",
        "selection_split_id"
      ],
      "properties": {
        "threshold_id": {
          "type": "string"
        },
        "metric_entry_id": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "selection_split_id": {
          "type": "string"
        },
        "validity_status": {
          "enum": [
            "VALID",
            "INVALID",
            "DIAGNOSTIC_ONLY"
          ]
        },
        "operating_point_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "ablation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "x-iharq-authority-status": "REGISTRY_REFERENCED"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csthv/IHARQ/schemas/records/PolicyUpdateTrace.schema.json",
  "title": "PolicyUpdateTrace Phase 0 foundation profile",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "schema_version",
    "authority_status",
    "owner_layer",
    "phase_id",
    "config_id",
    "source_ids",
    "evidence_mode",
    "limitation_tags",
    "lifecycle_status",
    "fixture",
    "fixture_tags",
    "evidence_role",
    "payload"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^IHARQ-[A-Z][A-Z0-9_]*-[0-9]{8}-[0-9a-f]{16}$"
    },
    "record_type": {
      "const": "PolicyUpdateTrace"
    },
    "schema_version": {
      "const": "1.0-foundation"
    },
    "authority_status": {
      "const": "REGISTRY_REFERENCED"
    },
    "owner_layer": {
      "const": "L7"
    },
    "phase_id": {
      "const": "P00"
    },
    "config_id": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_mode": {
      "enum": [
        "FOUNDATION",
        "IMPLEMENTATION",
        "CONFORMANCE",
        "VALIDATION",
        "REPRODUCIBILITY_READINESS"
      ]
    },
    "limitation_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lifecycle_status": {
      "enum": [
        "CREATED",
        "VALIDATED",
        "ACCEPTED",
        "DIAGNOSTIC_ONLY",
        "BLOCKED",
        "SUPERSEDED",
        "INVALIDATED"
      ]
    },
    "fixture": {
      "type": "boolean"
    },
    "fixture_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_role": {
      "enum": [
        "PRIMARY",
        "DERIVED",
        "GOVERNANCE",
        "RENDERING",
        "PACKAGING"
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "policy_update_trace_id",
            "policy_id",
            "source_transition_id",
            "reward_version",
            "seed"
          ],
          "properties": {
            "policy_update_trace_id": {
              "type": "string"
            },
            "policy_id": {
              "type": "string"
            },
            "source_transition_id": {
              "type": "string"
            },
            "reward_version": {
              "type": "string"
            },
            "seed": {
              "type": "integer"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "policy_update_trace_id",
            "source_transition_id",
            "before_policy_id",
            "after_policy_id",
            "policy_id",
            "reward_version",
            "cost_version",
            "config_id",
            "seed",
            "update_reason",
            "limitation_tags",
            "simulation_status"
          ],
          "properties": {
            "policy_update_trace_id": {
              "type": "string",
              "minLength": 1
            },
            "source_transition_id": {
              "type": "string",
              "minLength": 1
            },
            "before_policy_id": {
              "type": "string",
              "minLength": 1
            },
            "after_policy_id": {
              "type": "string",
              "minLength": 1
            },
            "policy_id": {
              "type": "string",
              "minLength": 1
            },
            "reward_version": {
              "type": "string",
              "minLength": 1
            },
            "cost_version": {
              "type": "string",
              "minLength": 1
            },
            "config_id": {
              "type": "string",
              "minLength": 1
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "update_reason": {
              "type": "string",
              "minLength": 1
            },
            "limitation_tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "simulation_status": {
              "const": "SIMULATION_ONLY"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ablation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "x-iharq-authority-status": "REGISTRY_REFERENCED"
}

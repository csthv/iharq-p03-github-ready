{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csthv/IHARQ/schemas/records/EvidenceRequestRecord.schema.json",
  "title": "EvidenceRequestRecord Phase 0 foundation profile",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "schema_version",
    "authority_status",
    "owner_layer",
    "phase_id",
    "config_id",
    "source_ids",
    "evidence_mode",
    "limitation_tags",
    "lifecycle_status",
    "fixture",
    "fixture_tags",
    "evidence_role",
    "payload"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^IHARQ-[A-Z][A-Z0-9_]*-[0-9]{8}-[0-9a-f]{16}$"
    },
    "record_type": {
      "const": "EvidenceRequestRecord"
    },
    "schema_version": {
      "const": "1.0-foundation"
    },
    "authority_status": {
      "const": "SOURCE_REFERENCED_LOCAL_PROFILE"
    },
    "owner_layer": {
      "const": "L4"
    },
    "phase_id": {
      "const": "P00"
    },
    "config_id": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_mode": {
      "enum": [
        "FOUNDATION",
        "IMPLEMENTATION",
        "CONFORMANCE",
        "VALIDATION",
        "REPRODUCIBILITY_READINESS"
      ]
    },
    "limitation_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lifecycle_status": {
      "enum": [
        "CREATED",
        "VALIDATED",
        "ACCEPTED",
        "DIAGNOSTIC_ONLY",
        "BLOCKED",
        "SUPERSEDED",
        "INVALIDATED"
      ]
    },
    "fixture": {
      "type": "boolean"
    },
    "fixture_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_role": {
      "enum": [
        "PRIMARY",
        "DERIVED",
        "GOVERNANCE",
        "RENDERING",
        "PACKAGING"
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "evidence_request_id",
            "source_prediction_id",
            "requested_evidence"
          ],
          "properties": {
            "evidence_request_id": {
              "type": "string"
            },
            "source_prediction_id": {
              "type": "string"
            },
            "requested_evidence": {
              "type": "array"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "evidence_request_id",
            "source_prediction_id",
            "source_uncertainty_id",
            "source_threshold_id",
            "requested_evidence",
            "request_status",
            "reason_code",
            "rule_id",
            "requested_at"
          ],
          "properties": {
            "evidence_request_id": {
              "type": "string",
              "minLength": 1
            },
            "source_prediction_id": {
              "type": "string",
              "minLength": 1
            },
            "source_uncertainty_id": {
              "type": "string",
              "minLength": 1
            },
            "source_threshold_id": {
              "type": "string",
              "minLength": 1
            },
            "requested_evidence": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "request_status": {
              "enum": [
                "OPEN",
                "SATISFIED",
                "INSUFFICIENT",
                "BLOCKED",
                "INVALID"
              ]
            },
            "reason_code": {
              "type": "string",
              "minLength": 1
            },
            "rule_id": {
              "type": "string",
              "minLength": 1
            },
            "requested_at": {
              "type": "string",
              "format": "date-time"
            },
            "abstention_allowed": {
              "type": "boolean"
            },
            "required_limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ablation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "x-iharq-authority-status": "SOURCE_REFERENCED_LOCAL_PROFILE"
}
